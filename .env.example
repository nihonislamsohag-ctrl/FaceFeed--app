# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# CLOUDINARY_CLOUD_NAME: Free Cloudinary cloud name for photo/video uploads without a credit card.
CLOUDINARY_CLOUD_NAME=MY_CLOUDINARY_CLOUD_NAME

# CLOUDINARY_UPLOAD_PRESET: Unsigned upload preset name created in Cloudinary Settings -> Upload.
CLOUDINARY_UPLOAD_PRESET=MY_CLOUDINARY_UPLOAD_PRESET

# AGORA_APP_ID: Free Agora RTC App ID for real-time Audio & Video Calling (10,000 free mins/month).
AGORA_APP_ID=MY_AGORA_APP_ID
